# Streamlit Community Cloud → your app → Settings → Secrets. Paste this, filled in.
# Never commit the real secrets.toml (it is in .gitignore).

# Run the FastAPI app inside the Streamlit process (Cloud runs only one process).
EMBED_API = "1"

# Supabase → Connect → Session pooler connection string, with the DB password.
DATABASE_URL = "postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DB_SCHEMA = "ledger"
