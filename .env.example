# Supabase → Project → Connect → "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Schema the API reads and writes. Tests always use ledger_test instead.
DB_SCHEMA=ledger

# Optional hardening knobs (defaults shown). See docs/DESIGN.md §10.
# DB_APP_ROLE=ledger_app          # role every connection switches to; empty disables
# DB_LOCK_TIMEOUT_MS=3000         # max wait for another request's row lock -> 503
# DB_STATEMENT_TIMEOUT_MS=5000    # max time for one SQL statement -> 503
# MAX_BODY_BYTES=16384            # larger request bodies -> 413

# Where the Streamlit UI finds the API.
API_URL=http://localhost:8000
